# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/buurtstallingen/.auth/
/e2e/buurtstallingen/.mail-capture.jsonl

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
docker/acceptance/library/*
!docker/acceptance/library/.gitkeep

# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.*
.env*
#do not exclude all .env*.example files
!*.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo

#deploy scripts
/scripts/updatelog.txt

# next-pwa generated (never check in)
/public/sw.js
/public/swe-worker*
/public/fallback*
/public/workbox*

/PRIVATE.md

#backups
mysql-db/export-db.sql
mysql-db/export-db.zip

# local MySQL data (Docker volume - restrictively permissioned, breaks build scans)
mysql-db/persist-db/

#uploads
/public/uploads*

# on-demand CSV export gzip cache (local development)
.cache/

#checkpoints
/data/checkpoints*
/data/ns

# Local Azure cost snapshots. Resource names, App Service plans, and billing stay out of git.
/data/azure-costs/

#auto generated test scripts
scripts/*.sql

#temporary files
/broncode
/buurtstallingen-broncode
debug.log
.tmp/

#temporary files
TESTQUERIES.sql
sql/*.sql
logs/*

#for now, do not check in prisma generated files
/src/generated/prisma-client/**/*

# generated OpenAPI markdown/pdf (`npm run docs:api` / prebuild)
/public/api-docs/

#local docs
/docs/**
!/docs/OSM*
!/docs/userdocs/
!/docs/userdocs/**
!/docs/documentatie-crow/
!/docs/documentatie-crow/1-api
!/docs/documentatie-crow/1-api/**
/docs/analyse-modules
/docs/analyse-change-dataowner/
!/docs/analyse-api/
!/docs/analyse-api/**
.tmp/
