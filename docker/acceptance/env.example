# Copy to docker/acceptance/.env (gitignored). Do not put PROD_DATABASE_URL here.
# This file is for acceptance (docker), not the Azure acceptance app.
# Generate secrets with: openssl rand -base64 32

MYSQL_PASSWORD=test-only-change-me
MYSQL_ROOT_PASSWORD=test-root

NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://127.0.0.1:3010
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STATIC_LIBRARY_BASE=http://127.0.0.1:3010
NEXT_PUBLIC_APP_ENV=acceptance
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3010

TEST_ENV_BOOTSTRAP=1
ENABLE_WRITE_API=true
OVERBOEKEN_CRON_ENABLED=1

CRON_SECRET=replace-with-a-long-random-string
UPDATE_CACHE_BEARER_TOKEN=replace-with-a-long-random-string
BUURTSTALLINGEN_JOB_TOKEN=replace-with-a-long-random-string

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=test@example.test

# Host dev (npm run dev) uses a different DATABASE_URL, in .env.local.
# The database name acc_docker is required. A URL that ends in /veiligstallen is refused before any write.
# DATABASE_URL=mysql://veiligstallen:test-only-change-me@127.0.0.1:5556/acc_docker
# PROD_DATABASE_URL=mysql://readonly:...@127.0.0.1:5557/veiligstallen
# MOLLIE_TEST_API_KEY=test_...
# MOLLIE_TEST_ID=
# LIBRARY_DIR is docker/acceptance/library on the host and /library in the app container.
