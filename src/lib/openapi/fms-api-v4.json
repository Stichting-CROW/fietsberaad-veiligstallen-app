        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "managedtransaction"
                    ],
                    "properties": {
                      "managedtransaction": {
                        "$ref": "#/components/schemas/V3ManagedTransaction"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "managedtransactions"
                    ],
                    "properties": {
                      "managedtransactions": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "$ref": "#/components/schemas/V3ManagedTransaction"
                        }
                      }
                    }
                  },
                  {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "$ref": "#/components/schemas/V3ManagedTransaction"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
